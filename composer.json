{
  "name": "suprim/geomaps",
  "description": "Location fields for Craft CMS: address autocomplete, GeoJSON drawing, proximity search, static and embedded maps, GraphQL and Feed Me support.",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "support@suprim.com.au",
    "issues": "https://github.com/suprim12/geomaps/issues?state=open",
    "source": "https://github.com/suprim12/geomaps",
    "docs": "https://github.com/suprim12/geomaps",
    "rss": "https://github.com/suprim12/geomaps/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.10.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/feed-me": "^6.0",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "suprim\\geomaps\\": "src/"
    }
  },
  "extra": {
    "handle": "geomaps",
    "name": "Geo Maps",
    "developer": "suprim",
    "documentationUrl": "https://github.com/suprim12/geomaps",
    "class": "suprim\\geomaps\\Plugin",
    "developerUrl": "https://suprimgolay.com.np",
    "developerEmail": "support@suprim.com.au",
    "changelogUrl": "https://raw.githubusercontent.com/suprim12/geomaps/main/CHANGELOG.md"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "maps",
    "map",
    "geo",
    "geojson",
    "location",
    "geocoding",
    "proximity search",
    "google maps",
    "leaflet"
  ]
}
