#}

{% set mapData = mapdata|merge({
	hideSearch: settings.hideSearch ?? false,
	hideAddress: settings.hideAddress ?? false,
	hideMap: settings.hideMap ?? false,
	enableGeoJson: settings.enableGeoJson ?? true,
	showMarker: settings.showMarker ?? true,
	minZoom: settings.minZoom ?? null,
	maxZoom: settings.maxZoom ?? null,
}) %}
{% if value is not empty %}
	{% set mapData = mapData|merge(value) %}
{% endif %}

{% set hideSearch = settings.hideSearch ?? false %}
{% set hideAddress = settings.hideAddress ?? false %}
{% set hideMap = settings.hideMap ?? false %}
{% set enableGeoJson = (settings.enableGeoJson ?? true) and not hideMap %}
{% set showMarker = settings.showMarker ?? true %}
{% set mapHeight = max(240, (settings.mapHeigth ?? 420)|integer) %}

{% macro textInput(id, name, key, label, attrs) %}
	<div class="supgeo__input{{ attrs.wide ?? false ? ' --wide' }}">
		<label class="supgeo__label" for="{{ id }}-{{ key }}">{{ label }}</label>
		<input id="{{ id }}-{{ key }}" class="text fullwidth" type="text" name="{{ name }}[{{ key }}]" x-model="{{ key }}" autocomplete="off"{% if attrs.inputmode ?? false %} inputmode="{{ attrs.inputmode }}"{% endif %}{% if attrs.placeholder ?? false %} placeholder="{{ attrs.placeholder }}"{% endif %}>
	</div>
{% endmacro %}

<div x-data="appgeo" x-init="initMap({{ mapData|json_encode }}, true, {{ settings|json_encode }})"
	class="supgeo{{ hideMap ? ' --hideMap' }}{{ hideAddress ? ' --noDetails' }}"
	:class="{ '--showEditor': showEditor, '--googleFailed': googleFailed || provider === 'osm' }"
	style="--supgeo-map-h: {{ mapHeight }}px">

	{% if not hideSearch %}
		<div class="supgeo__searchbar" x-ref="apgeo-search">
			<span class="supgeo__search-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
			<input type="text" class="supgeo__search-input text fullwidth"
				placeholder="{{ 'Search for an address or place'|t('geomaps') }}"
				aria-label="{{ 'Search for an address or place'|t('geomaps') }}"
				x-model="searchQuery" @input="onSearchInput()" @keydown="onSearchKeydown($event)" @blur="closeSuggestions()"
				autocomplete="off" role="combobox" aria-autocomplete="list" :aria-expanded="suggestionsOpen"
				:aria-activedescendant="activeSuggestion >= 0 ? '{{ id }}-suggestion-' + activeSuggestion : null">
			<span class="supgeo__spinner" x-cloak x-show="loadingSuggestions" aria-hidden="true"></span>
			<div x-ref="supgeo-places-attr" class="supgeo__sr" aria-hidden="true"></div>
			<ul class="supgeo-suggestions" x-cloak x-show="suggestionsOpen" role="listbox"
				x-transition:enter="supgeo-suggestions-enter" x-transition:enter-start="supgeo-suggestions-enter-start" x-transition:enter-end="supgeo-suggestions-enter-end">
				<template x-for="(s, i) in suggestions" :key="s.placeId">
					<li :id="'{{ id }}-suggestion-' + i" class="supgeo-suggestion-item" :class="{ '--active': activeSuggestion === i }" role="option" :aria-selected="activeSuggestion === i" @mousedown.prevent="selectSuggestion(s)" @mousemove="activeSuggestion = i">
						<svg class="supgeo-suggestion-pin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
						<span class="supgeo-suggestion-text">
							<span class="supgeo-suggestion-main" x-text="s.mainText"></span>
							<span class="supgeo-suggestion-secondary" x-text="s.secondaryText"></span>
						</span>
					</li>
				</template>
			</ul>
		</div>
	{% endif %}

	{% if not hideMap %}
	<div class="supgeo__notice" x-cloak x-show="googleFailed">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
		<span>{{ 'Google Maps rejected the API key, so OpenStreetMap is being used.'|t('geomaps') }} {% if currentUser.admin ?? false %}<a href="{{ settingsUrl }}">{{ 'Check the key'|t('geomaps') }}</a>{% endif %}</span>
		<button type="button" class="supgeo__notice-close" @click="googleFailed = false" aria-label="{{ 'Dismiss'|t('geomaps') }}">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
		</button>
	</div>
	{% endif %}

	<div class="supgeo__layout" x-ref="geowrapper">
		<div class="supgeo__stage">
			<div x-ref="appgeo-map" class="supgeo__map"></div>
			{% if enableGeoJson %}
			<div class="supgeo__geojson" x-cloak x-show="showEditor">
				<div class="supgeo__panel-head">
					<div>
						<div class="supgeo__panel-title">{{ 'GeoJSON'|t('geomaps') }}</div>
						<div class="supgeo__panel-desc">{{ 'The shapes drawn on the map. Edit here to update them.'|t('geomaps') }}</div>
					</div>
					<button type="button" class="supgeo__panel-close" @click="toggleEditor()" title="{{ 'Close GeoJSON'|t('geomaps') }}" aria-label="{{ 'Close GeoJSON'|t('geomaps') }}">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
					</button>
				</div>
				<div x-ref="geojson-editor" class="geojson-editor"></div>
			</div>
			{% endif %}

				{# Property Value Editor Panel #}
				<div class="supgeo__prop-modal-overlay" x-cloak x-show="featurePropEditorOpen" @click.self="closePropEditor()">
					<div class="supgeo__prop-modal">
						<div class="supgeo__prop-modal-tabs">
							<button type="button" :class="{ '--active': featureEditingPropType === 'text' }" @click="setPropType('text')">Text</button>
							<button type="button" :class="{ '--active': featureEditingPropType === 'json' }" @click="setPropType('json')">JSON</button>
							<button type="button" :class="{ '--active': featureEditingPropType === 'boolean' }" @click="setPropType('boolean')">True/False</button>
							<button type="button" :class="{ '--active': featureEditingPropType === 'number' }" @click="setPropType('number')">Number</button>
							<button type="button" :class="{ '--active': featureEditingPropType === 'color' }" @click="setPropType('color')">Color</button>
						</div>
						<div class="supgeo__prop-modal-body">
							<template x-if="featureEditingPropType === 'text' || featureEditingPropType === 'json' || featureEditingPropType === 'number'">
								<textarea class="supgeo__prop-modal-textarea" x-model="featureEditingPropRaw" :class="{ '--mono': featureEditingPropType !== 'text', '--error': featureEditingPropError }" rows="6" spellcheck="false"></textarea>
							</template>
							<template x-if="featureEditingPropType === 'boolean'">
								<div class="supgeo__prop-bool">
									<button type="button" class="supgeo__prop-bool-btn" :class="{ '--active': featureEditingPropRaw === 'true' }" @click="featureEditingPropRaw = 'true'">
										<svg width="14" height="14" viewbox="0 0 14 14" fill="none"><path d="M2 7l4 4 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
										True
									</button>
									<button type="button" class="supgeo__prop-bool-btn" :class="{ '--active': featureEditingPropRaw === 'false' }" @click="featureEditingPropRaw = 'false'">
										<svg width="14" height="14" viewbox="0 0 14 14" fill="none"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
										False
									</button>
								</div>
							</template>
							<template x-if="featureEditingPropType === 'color'">
								<div class="supgeo__prop-color">
									<div class="supgeo__prop-color-swatch" :style="'background:' + featureEditingPropRaw"></div>
									<input type="color" :value="featureEditingPropRaw" @input="featureEditingPropRaw = $event.target.value" class="supgeo__prop-color-picker"/>
									<input type="text" x-model="featureEditingPropRaw" class="supgeo__fe-input --mono" placeholder="#6366f1"/>
								</div>
							</template>
							<p class="supgeo__prop-modal-error" x-show="featureEditingPropError" x-text="featureEditingPropError"></p>
						</div>

						{# Footer #}
						<div class="supgeo__prop-modal-footer">
							<button type="button" class="supgeo__fe-del-btn" @click="deletePropFromEditor()">
								<svg width="13" height="13" viewbox="0 0 13 13" fill="none"><path d="M2 3h9M5 3V2h3v1M3 3l.5 8h6L10 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
								Delete
							</button>
							<div style="display:flex;gap:6px;">
								<button type="button" class="btn" @click="closePropEditor()">Cancel</button>
								<button type="button" class="btn submit" @click="savePropEditor()">✓ Done</button>
							</div>
						</div>
					</div>
				</div>
				{# Feature Editor Panel #}
				<div class="supgeo__feature-editor" x-cloak x-show="featureEditorOpen" x-transition:enter="supgeo-fade-enter" x-transition:enter-start="supgeo-fade-enter-start" x-transition:enter-end="supgeo-fade-enter-end" x-transition:leave="supgeo-fade-leave" x-transition:leave-end="supgeo-fade-leave-end">
					<div class="supgeo__fe-header">
						<span class="supgeo__fe-title">
							Feature
							<span class="supgeo__fe-badge" x-text="featureGeomType"></span>
						</span>
						<button type="button" class="supgeo__fe-close" @click="closeFeatureEditor()" aria-label="Close feature editor">
							<svg width="14" height="14" viewbox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
						</button>
					</div>

					<div class="supgeo__fe-tabs">
						<button type="button" class="supgeo__fe-tab" :class="{ '--active': featureEditorTab === 'properties' }" @click="featureEditorTab = 'properties'">Properties</button>
						<button type="button" class="supgeo__fe-tab" :class="{ '--active': featureEditorTab === 'geojson' }" @click="featureEditorTab = 'geojson'">GeoJSON</button>
					</div>
					{# Properties Tab #}
					<div class="supgeo__fe-body" x-show="featureEditorTab === 'properties'">
						<table class="supgeo__fe-table" x-show="featureProps.length > 0">
							<thead>
								<tr>
									<th>Key</th>
									<th>Value</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								<template x-for="(prop, i) in featureProps" :key="i">
									<tr>
										<td><input type="text" x-model="prop.key" @change="featurePropChanged()" class="supgeo__fe-input"/></td>
										<td><input type="text" x-model="prop.val" @change="featurePropChanged()" class="supgeo__fe-input"/></td>
										<td>
											<button type="button" class="supgeo__fe-edit-btn" @click="openPropEditor(i)" aria-label="Edit value">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
													<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
												</svg>
											</button>
										</td>
										<td>
											<button type="button" class="supgeo__fe-del" @click="featureRemoveProp(i)" aria-label="Delete property">
												<svg width="13" height="13" viewbox="0 0 13 13" fill="none"><path d="M1 1l11 11M12 1L1 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
											</button>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
						<div class="supgeo__fe-empty" x-show="featureProps.length <= 0">
							No properties yet
						</div>
						<div class="supgeo__fe-addrow">
							<input type="text" x-model="featurePropNewKey" placeholder="Key" class="supgeo__fe-input" @keydown.enter="featureAddProp()"/>
							<input type="text" x-model="featurePropNewVal" placeholder="Value" class="supgeo__fe-input" @keydown.enter="featureAddProp()"/>
							<button type="button" class="btn small" @click="featureAddProp()">+ Add</button>
						</div>
					</div>
					{# GeoJSON Tab #}
					<div class="supgeo__fe-body" x-show="featureEditorTab === 'geojson'">
						<pre class="supgeo__fe-pre" x-text="getFeatureGeoJSONString()"></pre>
						<div class="supgeo__fe-copy-bar">
							<button type="button" class="btn small" @click="featureCopyGeoJSON()" :class="{ '--copied': featureCopied }">
								<span x-text="featureCopied ? '✓ Copied' : 'Copy GeoJSON'"></span>
							</button>
						</div>
					</div>
			</div>
		</div>

		{% if not hideAddress %}
			<div class="supgeo__details" x-show="!showEditor">
				<div class="supgeo__details-head">{{ 'Location details'|t('geomaps') }}</div>
				<div class="supgeo__grid">
					{{ _self.textInput(id, name, 'full_address', 'Full address'|t('geomaps'), { wide: true }) }}
					{{ _self.textInput(id, name, 'address1', 'Street address'|t('geomaps'), { wide: true }) }}
					{{ _self.textInput(id, name, 'suburb', 'Suburb / City'|t('geomaps')) }}
					{{ _self.textInput(id, name, 'postcode', 'Postcode'|t('geomaps')) }}
					{{ _self.textInput(id, name, 'country', 'Country'|t('geomaps'), { wide: true }) }}
					{% if showMarker %}
						{{ _self.textInput(id, name, 'lat', 'Latitude'|t('geomaps'), { inputmode: 'decimal' }) }}
						{{ _self.textInput(id, name, 'lng', 'Longitude'|t('geomaps'), { inputmode: 'decimal' }) }}
					{% else %}
						{# Without a pin, the location is set from the centre of the shapes when the entry is saved. #}
						<input type="hidden" name="{{ name }}[lat]" :value="lat">
						<input type="hidden" name="{{ name }}[lng]" :value="lng">
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>

	{# Values must still post when the details panel is hidden. #}
	{% if hideAddress %}
		{% for key in ['full_address', 'address1', 'suburb', 'postcode', 'country', 'lat', 'lng'] %}
			<input type="hidden" name="{{ name }}[{{ key }}]" :value="{{ key }}">
		{% endfor %}
	{% endif %}
	<input type="hidden" name="{{ name }}[countryCode]" :value="countryCode">
	<textarea hidden name="{{ name }}[geoJson]" x-model="geojsonText"></textarea>

	<div class="supgeo__footer">
		<div class="supgeo__status">
			<span class="supgeo__chip" :class="{ '--empty': !hasLocation }">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
				<span x-text="hasLocation ? lat + ', ' + lng : '{{ 'No location set'|t('geomaps')|e('js') }}'">{{ 'No location set'|t('geomaps') }}</span>
			</span>
			<button type="button" class="btn supgeo__clear" x-cloak x-show="hasLocation || full_address" @click="clearAddress()">{{ 'Clear'|t('geomaps') }}</button>
			{% if not hideMap %}
				<span class="supgeo__hint">{{ showMarker ? 'Search, click the map, or drag the pin.'|t('geomaps') : 'Draw the area with the tools on the left. Its location is the centre of the shapes.'|t('geomaps') }}</span>
			{% endif %}
		</div>

		{% if enableGeoJson %}
		<div class="btngroup supgeo__tools">
			<button type="button" class="btn supgeo__toggle" :class="{ active: showEditor }" @click="toggleEditor()" :aria-pressed="showEditor.toString()" :title="showEditor ? '{{ 'Hide the GeoJSON editor'|t('geomaps')|e('js') }}' : '{{ 'View and edit shapes as GeoJSON'|t('geomaps')|e('js') }}'">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m8 16-4-4 4-4M16 8l4 4-4 4"/></svg>
				<span x-text="showEditor ? '{{ 'Hide GeoJSON'|t('geomaps')|e('js') }}' : '{{ 'Edit GeoJSON'|t('geomaps')|e('js') }}'">{{ 'Edit GeoJSON'|t('geomaps') }}</span>
			</button>
			<button type="button" class="btn" @click.prevent="download({{ elementId ?? 'null' }})" title="{{ 'Download GeoJSON'|t('geomaps') }}">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg>
				<span>{{ 'Download'|t('geomaps') }}</span>
			</button>
			<button type="button" class="btn" @click="triggerUpload()" :disabled="uploadStatus === 'reading' || uploadStatus === 'parsing'" title="{{ 'Upload a GeoJSON file'|t('geomaps') }}">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 20V9m0 0-4 4m4-4 4 4M5 4h14"/></svg>
				<span>{{ 'Upload'|t('geomaps') }}</span>
			</button>
		</div>
		{% endif %}
	</div>

	<div class="supgeo-upload-wrap">
				<input type="file" accept=".geojson,.json,application/json,application/geo+json" x-ref="geojson-upload-input" class="supgeo-upload-hidden" @change="uploadGeoJSON($event.target.files[0]); $event.target.value = ''"/>
				<div class="supgeo-upload-progress" x-show="uploadStatus !== null" x-transition:enter="supgeo-fade-enter" x-transition:enter-start="supgeo-fade-enter-start" x-transition:leave="supgeo-fade-leave" x-transition:leave-end="supgeo-fade-leave-end">
					<div class="supgeo-progress-track" x-show="uploadStatus !== 'error'" role="progressbar" :aria-valuenow="uploadProgress" aria-valuemin="0" aria-valuemax="100">
						<div class="supgeo-progress-bar" :class="{
																																		'--reading':  uploadStatus === 'reading',
																																		'--parsing':  uploadStatus === 'parsing',
																																		'--done':     uploadStatus === 'done'
																																	}" :style="`width: ${uploadProgress}%`"></div>
					</div>

					<span class="supgeo-upload-label">
						<template x-if="uploadStatus === 'reading'">
							<span>Reading file…
								<strong x-text="uploadProgress + '%'"></strong>
							</span>
						</template>
						<template x-if="uploadStatus === 'parsing'">
							<span>Parsing GeoJSON…</span>
						</template>
						<template x-if="uploadStatus === 'done'">
							<span class="--success">✓ GeoJSON loaded successfully</span>
						</template>
						<template x-if="uploadStatus === 'error'">
							<span class="--error">✗
								<span x-text="uploadError"></span>
							</span>
						</template>
					</span>
				</div>

			</div>
</div>
