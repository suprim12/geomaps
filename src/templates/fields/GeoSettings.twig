{% import '_includes/forms.twig' as forms %}


{{ forms.field({
	label: 'Initial Location',
	instructions: 'The initial location and zoom that will show in the map field',
}, map) }}


{{ forms.lightswitchField({
	label: 'Enable Drawing & GeoJSON'|t('geo'),
	instructions: 'Let authors draw markers, lines and areas on the map and edit them as GeoJSON. Turn off if you only need a single location.'|t('geo'),
	id: 'enableGeoJson',
	name: 'enableGeoJson',
	on: field.enableGeoJson
}) }}

{{ forms.lightswitchField({
	label: 'Hide Search',
	instructions: 'Hide the address search. Authors can still click the map or type coordinates.'|t('geo'),
	id: 'hideSearch',
	name: 'hideSearch',
	on: field.hideSearch
}) }}

{{ forms.lightswitchField({
	label: 'Hide Address',
	instructions: 'Hide the address and coordinate fields. Values are still saved from search and the map.'|t('geo'),
	id: 'hideAddress',
	name: 'hideAddress',
	on: field.hideAddress
}) }}

{{ forms.lightswitchField({
	label: 'Hide Map',
	instructions: 'Hide the map, leaving only search and the address fields. Also hides drawing.'|t('geo'),
	id: 'hideMap',
	name: 'hideMap',
	on: field.hideMap
}) }}


{{ forms.textField({
	label: 'Map Height'|t('geo'),
	instructions: 'Height of the map in the control panel, in pixels.'|t('geo'),
	id: 'mapHeigth',
	name: 'mapHeigth',
	type: 'number',
	value: field.mapHeigth,
	min: 240,
	max: 1200,
	step: 10,
	size: 6,
	errors: field.getErrors('mapHeigth'),
}) }}

{{ forms.textField({
	label: 'Min Zoom'|t('geo'),
	instructions: 'How far authors can zoom out (0 = whole world).'|t('geo'),
	id: 'minZoom',
	name: 'minZoom',
	type: 'number',
	value: field.minZoom,
	errors: field.getErrors('minZoom'),
	min: 0,
	max: 18,
	step: 1,
	size: 6,
}) }}

{{ forms.textField({
	label: 'Max Zoom'|t('geo'),
	instructions: 'How far authors can zoom in (18 = street level).'|t('geo'),
	id: 'maxZoom',
	name: 'maxZoom',
	type: 'number',
	value: field.maxZoom,
	errors: field.getErrors('maxZoom'),
	min: 0,
	max: 18,
	step: 1,
	size: 6,
}) }}

{{ forms.selectizeField({
	label: 'Limit Search to Countries'|t('geo'),
	instructions: 'Only show address search results in these countries (up to 5). Leave empty to search everywhere.'|t('geo'),
	id: 'countries',
	name: 'countries',
	multi: true,
	selectizeOptions: { maxItems: 5 },
	options: countries,
	values: field.getSearchCountries(),
	errors: field.getErrors('countries'),
}) }}

