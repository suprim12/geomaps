{% import '_includes/forms.twig' as forms %}


{{ forms.field({
	label: 'Initial Location'|t('geomaps'),
	instructions: 'Where the map starts, and how far it’s zoomed in, for entries without a location. Click the map or drag the pin, and zoom to the level you want.'|t('geomaps'),
}, map) }}


{{ forms.lightswitchField({
	label: 'Enable Drawing & GeoJSON'|t('geomaps'),
	instructions: 'Let authors draw markers, lines and areas on the map and edit them as GeoJSON. Turn off if you only need a single location.'|t('geomaps'),
	id: 'enableGeoJson',
	name: 'enableGeoJson',
	on: field.enableGeoJson
}) }}

{{ forms.lightswitchField({
	label: 'Show Location Pin'|t('geomaps'),
	instructions: 'Turn off for fields that only hold shapes, such as delivery or bin-collection zones. The entry’s location is then the centre of its shapes, so distance search still works.'|t('geomaps'),
	id: 'showMarker',
	name: 'showMarker',
	on: field.showMarker
}) }}

{{ forms.lightswitchField({
	label: 'Hide Search',
	instructions: 'Hide the address search. Authors can still click the map or type coordinates.'|t('geomaps'),
	id: 'hideSearch',
	name: 'hideSearch',
	on: field.hideSearch
}) }}

{{ forms.lightswitchField({
	label: 'Hide Address',
	instructions: 'Hide the address and coordinate fields. Values are still saved from search and the map.'|t('geomaps'),
	id: 'hideAddress',
	name: 'hideAddress',
	on: field.hideAddress
}) }}

{{ forms.lightswitchField({
	label: 'Hide Map',
	instructions: 'Hide the map, leaving only search and the address fields. Also hides drawing.'|t('geomaps'),
	id: 'hideMap',
	name: 'hideMap',
	on: field.hideMap
}) }}


{{ forms.textField({
	label: 'Map Height'|t('geomaps'),
	instructions: 'Height of the map in the control panel, in pixels.'|t('geomaps'),
	id: 'mapHeigth',
	name: 'mapHeigth',
	type: 'number',
	value: field.mapHeigth,
	min: 240,
	max: 1200,
	step: 10,
	size: 6,
	errors: field.getErrors('mapHeigth'),
}) }}

{{ forms.textField({
	label: 'Min Zoom'|t('geomaps'),
	instructions: 'How far authors can zoom out (0 = whole world).'|t('geomaps'),
	id: 'minZoom',
	name: 'minZoom',
	type: 'number',
	value: field.minZoom,
	errors: field.getErrors('minZoom'),
	min: 0,
	max: 18,
	step: 1,
	size: 6,
}) }}

{{ forms.textField({
	label: 'Max Zoom'|t('geomaps'),
	instructions: 'How far authors can zoom in (18 = street level).'|t('geomaps'),
	id: 'maxZoom',
	name: 'maxZoom',
	type: 'number',
	value: field.maxZoom,
	errors: field.getErrors('maxZoom'),
	min: 0,
	max: 18,
	step: 1,
	size: 6,
}) }}

{{ forms.selectizeField({
	label: 'Limit Search to Countries'|t('geomaps'),
	instructions: 'Only show address search results in these countries (up to 5). Leave empty to search everywhere.'|t('geomaps'),
	id: 'countries',
	name: 'countries',
	multi: true,
	selectizeOptions: { maxItems: 5 },
	options: countries,
	values: field.getSearchCountries(),
	errors: field.getErrors('countries'),
}) }}

