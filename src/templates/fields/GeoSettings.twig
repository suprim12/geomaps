{% import '_includes/forms.twig' as forms %}


{{ forms.field({
	label: 'Initial Location',
	instructions: 'The initial location and zoom that will show in the map field',
}, map) }}


{{ forms.lightswitchField({
	label: 'Hide Search',
	instructions: 'Hide the location search field',
	id: 'hideSearch',
	name: 'hideSearch',
	on: field.hideSearch
}) }}

{{ forms.lightswitchField({
	label: 'Hide Address',
	instructions: 'Hide the address fields',
	id: 'hideAddress',
	name: 'hideAddress',
	on: field.hideAddress
}) }}

{{ forms.lightswitchField({
	label: 'Hide Map',
	instructions: 'Hide the map',
	id: 'hideMap',
	name: 'hideMap',
	on: field.hideMap
}) }}


{{ forms.textField({
	label: 'Map Height'|t('geo'),
	instructions: 'Height of the map in the control panel, in pixels.'|t('geo'),
	id: 'mapHeigth',
	name: 'mapHeigth',
	type: 'number',
	value: field.mapHeigth,
	min: 240,
	max: 1200,
	step: 10,
	size: 6,
	errors: field.getErrors('mapHeigth'),
}) }}

{{ forms.textField({
	label: 'Min Zoom',
	instructions: 'The minimum level the user can zoom the map out to.',
	id: 'minZoom',
	name: 'minZoom',
	type: 'number',
	value: field.minZoom,
	min: 0,
	max: 18,
	step: 0.01,
	size: 6,
}) }}

{{ forms.textField({
	label: 'Max Zoom',
	instructions: 'The maximum level the user can zoom the map in to.',
	id: 'maxZoom',
	name: 'maxZoom',
	type: 'number',
	value: field.maxZoom,
	min: 0,
	max: 18,
	step: 0.01,
	size: 6,
}) }}

{{ forms.selectField({
	label: 'Preferred Country',
	instructions: 'Address search results are limited to this country.'|t('geo'),
	id: 'country',
	name: 'country',
	options: countries,
	value: field.country,
}) }}

