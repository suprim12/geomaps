{#
	* Geo Maps plugin for Craft CMS
	*
	* @link      https://suprim.com.au
	* @author suprim <support@suprim.com.au> <https://suprim.com.au>
	* @copyright Copyright (c) 2026 suprim
#}

{% import '_includes/forms.twig' as forms %}

{% set configFileExists = config is not empty %}
{# Only mention the config file when it sets something shown on this page. #}
{% set lockedHere = configFileExists and (config|keys|filter(k => k in ['service', 'mapToken', 'geoToken', 'mapboxToken', 'mapboxStyle', 'tileUrl', 'tileAttribution'])|length) %}
{% set docs = 'https://plugins.geomaps.suprim.com.au' %}
{% set isPro = plugin.isPro() %}
{% set service = settings.getService() %}
{% set usesGoogleMaps = settings.getMapProvider('cp') == 'google' %}
{% macro mapName(provider) %}{{ provider == 'google' ? 'Google Maps' : craft.app.plugins.getPlugin('geomaps').getSettings().getTileProviderName() }}{% endmacro %}
{% from _self import mapName %}
{% set geocoder = settings.getGeocoder() %}
{% set geocoderNames = { google: 'Google', mapbox: 'Mapbox', nominatim: 'OpenStreetMap' } %}

{% set icons = {
	map: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>',
	search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
	pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>',
	key: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.3-9.3M17 6l3 3M15 8l2 2"/></svg>',
	star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z"/></svg>',
} %}


<div class="gm">

	{% if lockedHere %}
		<div class="gm-notice">
			{{ icons.key|raw }}
			<p>{{ 'Some settings are set in {file} and can’t be changed here.'|t('geomaps', { file: '<code>config/geomaps.php</code>' })|raw }}</p>
		</div>
	{% endif %}

	{# Overview: what this site is using right now. #}
	<div class="gm-status">
		<div class="gm-status__item">
			<span class="gm-status__icon">{{ icons.map|raw }}</span>
			<span class="gm-status__label">{{ 'Maps'|t('geomaps') }}</span>
			<span class="gm-status__value"><span class="status green"></span>{{ mapName(settings.getMapProvider('site')) }}{% if settings.getMapProvider('cp') != settings.getMapProvider('site') %}<span class="gm-status__sub">· {{ 'CP: {name}'|t('geomaps', { name: mapName(settings.getMapProvider('cp')) }) }}</span>{% endif %}</span>
		</div>
		<div class="gm-status__item">
			<span class="gm-status__icon">{{ icons.search|raw }}</span>
			<span class="gm-status__label">{{ 'Address search'|t('geomaps') }}</span>
			<span class="gm-status__value"><span class="status green"></span>{{ settings.usesMapboxForSaving() ? 'Mapbox' : (usesGoogleMaps ? 'Google Places' : 'OpenStreetMap') }}</span>
		</div>
		<div class="gm-status__item">
			<span class="gm-status__icon">{{ icons.pin|raw }}</span>
			<span class="gm-status__label">{{ 'Location search'|t('geomaps') }}</span>
			<span class="gm-status__value"><span class="status green"></span>{{ geocoderNames[geocoder] }}</span>
		</div>
		<div class="gm-status__item">
			<span class="gm-status__icon">{{ icons.star|raw }}</span>
			<span class="gm-status__label">{{ 'Edition'|t('geomaps') }}</span>
			<span class="gm-status__value">
				{% if isPro %}<span class="gm-badge gm-badge--pro">Pro</span>{% else %}<span class="gm-badge">{{ 'Free'|t('geomaps') }}</span> <a class="gm-status__link" href="{{ docs }}/getting-started/pro" target="_blank" rel="noopener">{{ 'Try Pro'|t('geomaps') }}</a>{% endif %}
			</span>
		</div>
	</div>

	{# Map service #}
	{% set serviceLocked = configFileExists and config.service is defined %}
	{# Whether each service's keys are set, using their real values (an environment variable can be empty). #}
	{% set browserKey = settings.getMapToken() %}
	{% set serverKey = settings.getGeoToken() %}
	{% set mapboxToken = settings.getMapboxToken() %}
	{% set googleBadge = browserKey and serverKey ? { text: 'Keys set'|t('geomaps'), class: 'gm-badge--on' }
		: browserKey ? { text: 'Browser key only'|t('geomaps'), class: 'gm-badge--warn' }
		: settings.mapToken ? { text: 'Key not found'|t('geomaps'), class: 'gm-badge--warn' }
		: { text: 'Two keys'|t('geomaps'), class: '' } %}
	{% set mapboxBadge = mapboxToken ? { text: 'Token set'|t('geomaps'), class: 'gm-badge--on' }
		: settings.mapboxToken ? { text: 'Token not found'|t('geomaps'), class: 'gm-badge--warn' }
		: { text: 'Access token'|t('geomaps'), class: '' } %}
	{% set services = [
		{ value: 'openstreetmap', name: 'OpenStreetMap', badge: { text: 'No key'|t('geomaps'), class: '' }, text: 'Free maps and address search. Good for the control panel and light use.'|t('geomaps') },
		{ value: 'mapbox', name: 'Mapbox', badge: mapboxBadge, text: 'Styled maps and accurate address search, with a free monthly allowance.'|t('geomaps') },
		{ value: 'google', name: 'Google Maps', badge: googleBadge, text: 'Google maps, Places address search and Google lookups.'|t('geomaps') },
	] %}
	<section class="gm-card">
		<header class="gm-card__head">
			<span class="gm-card__icon">{{ icons.map|raw }}</span>
			<div>
				<h2>{{ 'Map service'|t('geomaps') }}</h2>
				<p>{{ 'Maps in the field and on your site, address search, location lookups and static map images all use this service. If it refuses a request, Geo Maps uses OpenStreetMap instead.'|t('geomaps') }}</p>
			</div>
		</header>

		<div class="gm-card__body">
			<div class="gm-services" role="radiogroup" aria-label="{{ 'Map service'|t('geomaps') }}">
				{% for option in services %}
					<label class="gm-service{{ option.value == service ? ' is-on' }}">
						<input type="radio" name="service" value="{{ option.value }}"{{ option.value == service ? ' checked' }}{{ serviceLocked ? ' disabled' }} data-gm-service>
						<span class="gm-service__name">{{ option.name }} <span class="gm-badge {{ option.badge.class }}">{% if option.badge.class == 'gm-badge--on' %}<span class="status green"></span>{% endif %}{{ option.badge.text }}</span></span>
						<span class="gm-service__text">{{ option.text }}</span>
					</label>
				{% endfor %}
			</div>
			{% if settings.getErrors('service') %}{{ forms.errorList(settings.getErrors('service')) }}{% endif %}

			{# OpenStreetMap #}
			<div class="gm-panel" data-gm-panel="openstreetmap"{{ service != 'openstreetmap' ? ' hidden' }}>
				<p class="gm-panel__intro">{{ 'Nothing to set up. The free OpenStreetMap tiles are for light use; busy public sites should use Mapbox, or another tile provider such as {stadia}, {maptiler} or {thunderforest}.'|t('geomaps', {
					stadia: '<a href="https://stadiamaps.com" target="_blank" rel="noopener">Stadia Maps</a>',
					maptiler: '<a href="https://www.maptiler.com" target="_blank" rel="noopener">MapTiler</a>',
					thunderforest: '<a href="https://www.thunderforest.com" target="_blank" rel="noopener">Thunderforest</a>',
				})|raw }}</p>
				{# A Mapbox tiles URL from before 1.4 now belongs to the Mapbox option, so it isn't shown here. #}
				{% set customTiles = 'api.mapbox.com/styles/' not in settings.tileUrl and (settings.tileUrl != constant('suprim\\geomaps\\models\\Settings::OSM_TILE_URL') or settings.tileAttribution != constant('suprim\\geomaps\\models\\Settings::OSM_ATTRIBUTION')) %}
				<details class="gm-help"{{ customTiles ? ' open' }}>
					<summary>{{ 'Use another tile provider'|t('geomaps') }}</summary>
					{{ forms.autosuggestField({
						label: 'Map tiles URL'|t('geomaps'),
						instructions: '`{z}`, `{x}` and `{y}` are filled in for each square of the map.'|t('geomaps'),
						id: 'tileUrl',
						name: 'tileUrl',
						suggestEnvVars: true,
						value: customTiles ? settings.tileUrl : constant('suprim\\geomaps\\models\\Settings::OSM_TILE_URL'),
						placeholder: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
						disabled: configFileExists and config.tileUrl is defined,
						errors: settings.getErrors('tileUrl'),
					}) }}
					{{ forms.textField({
						label: 'Map credit'|t('geomaps'),
						instructions: 'Shown in the corner of the map. Tile providers require it. HTML allowed.'|t('geomaps'),
						id: 'tileAttribution',
						name: 'tileAttribution',
						value: customTiles ? settings.tileAttribution : constant('suprim\\geomaps\\models\\Settings::OSM_ATTRIBUTION'),
						disabled: configFileExists and config.tileAttribution is defined,
						errors: settings.getErrors('tileAttribution'),
					}) }}
				</details>
			</div>

			{# Mapbox #}
			<div class="gm-panel" data-gm-panel="mapbox"{{ service != 'mapbox' ? ' hidden' }}>
				{{ forms.autosuggestField({
					label: 'Access token'|t('geomaps'),
					instructions: 'A public token (starting `pk.`) from your {link}. Restrict it to your site’s domains in Mapbox.'|t('geomaps', { link: '[Mapbox account](https://account.mapbox.com/access-tokens/)' }),
					id: 'mapboxToken',
					name: 'mapboxToken',
					suggestEnvVars: true,
					value: settings.mapboxToken ?: settings.getOldMapboxToken(),
					placeholder: '$MAPBOX_TOKEN',
					disabled: configFileExists and config.mapboxToken is defined,
					errors: settings.getErrors('mapboxToken'),
				}) }}

				<div class="field">
					<div class="heading"><label for="{{ 'mapboxStyle'|namespaceInputId }}">{{ 'Style'|t('geomaps') }}</label></div>
					<div class="instructions"><p>{{ 'Pick a style, or paste a style URL from Mapbox Studio (`mapbox://styles/…`).'|t('geomaps')|md(inlineOnly=true) }}</p></div>
					<div class="gm-presets">
						{% for style, label in constant('suprim\\geomaps\\models\\Settings::MAPBOX_STYLES') %}
							<button type="button" class="gm-preset" data-gm-style="{{ style }}">{{ label|t('geomaps') }}</button>
						{% endfor %}
					</div>
					{{ forms.text({
						id: 'mapboxStyle',
						name: 'mapboxStyle',
						value: settings.getMapboxStyle() ?? settings.mapboxStyle,
						placeholder: 'mapbox://styles/your-name/style-id',
						disabled: configFileExists and config.mapboxStyle is defined,
					}) }}
					{% if settings.getErrors('mapboxStyle') %}{{ forms.errorList(settings.getErrors('mapboxStyle')) }}{% endif %}
				</div>

				<div class="gm-preview" data-gm-preview data-token="{{ settings.getMapboxToken() }}">
					<div class="gm-preview__tiles" aria-hidden="true"></div>
					<p class="gm-preview__caption" data-default="{{ 'Preview of Adelaide in this style'|t('geomaps') }}" data-env="{{ 'Save to preview with a new token.'|t('geomaps') }}">{{ 'Preview of Adelaide in this style'|t('geomaps') }}</p>
				</div>

				{# Config file only: saving this page turns it back on unless the config file sets it. #}
				{% if not (configFileExists and config.mapboxPermanent is defined) %}{{ hiddenInput('mapboxPermanent', '1') }}{% endif %}
				<p class="gm-panel__note">{{ 'Saved addresses use Mapbox permanent geocoding, which needs a card on your Mapbox account. Mapbox requires its logo on public maps. {link}'|t('geomaps', {
					link: '<a href="' ~ docs ~ '/examples/mapbox" target="_blank" rel="noopener">' ~ 'Mapbox setup'|t('geomaps') ~ '</a>',
				})|raw }}</p>
			</div>

			{# Google #}
			<div class="gm-panel" data-gm-panel="google"{{ service != 'google' ? ' hidden' }}>
				{{ forms.autosuggestField({
					label: 'Browser key'|t('geomaps'),
					instructions: 'Used in browsers for Google maps, address suggestions and static images, so it’s visible in the page. Restrict it to your site’s domains.'|t('geomaps'),
					id: 'mapToken',
					name: 'mapToken',
					suggestEnvVars: true,
					value: settings.mapToken,
					placeholder: '$GOOGLE_MAPS_KEY',
					disabled: configFileExists and config.mapToken is defined,
					errors: settings.getErrors('mapToken'),
				}) }}

				{{ forms.autosuggestField({
					label: 'Server key'|t('geomaps'),
					instructions: 'Used by Craft to look up addresses in searches such as {example}. Never sent to browsers, so restrict it to your server’s IP address. Without it, OpenStreetMap is used for lookups.'|t('geomaps', { example: '`location: \'Adelaide\'`' }),
					id: 'geoToken',
					name: 'geoToken',
					suggestEnvVars: true,
					value: settings.geoToken,
					placeholder: '$GOOGLE_GEOCODING_KEY',
					disabled: configFileExists and config.geoToken is defined,
					errors: settings.getErrors('geoToken'),
				}) }}

				<details class="gm-help">
					<summary>{{ 'How to set up your Google keys'|t('geomaps') }}</summary>
					<ol>
						<li>{{ 'In the {link}, create a project and turn on billing.'|t('geomaps', { link: '<a href="https://console.cloud.google.com/google/maps-apis" target="_blank" rel="noopener">Google Cloud console</a>' })|raw }}</li>
						<li>{{ 'Enable the <strong>Maps JavaScript API</strong>, <strong>Places API</strong>, <strong>Maps Static API</strong> and <strong>Geocoding API</strong> for the browser key, and the <strong>Geocoding API</strong> for the server key.'|t('geomaps')|raw }}</li>
						<li>{{ 'Restrict the browser key to your domains (HTTP referrers), including local ones such as <code>*.ddev.site/*</code>, and the server key to your server’s IP address.'|t('geomaps')|raw }}</li>
						<li>{{ 'Store the keys in your <code>.env</code> file and enter them here as environment variables, such as <code>$GOOGLE_MAPS_KEY</code>.'|t('geomaps')|raw }}</li>
					</ol>
				</details>
			</div>
		</div>
	</section>

	<footer class="gm-footer">
		<a href="{{ docs }}" target="_blank" rel="noopener">{{ 'Documentation'|t('geomaps') }}</a>
		<a href="https://github.com/suprim12/geomaps/issues" target="_blank" rel="noopener">{{ 'Report an issue'|t('geomaps') }}</a>
		<a href="mailto:support@suprim.com.au">{{ 'Email support'|t('geomaps') }}</a>
		<span>Geo Maps {{ plugin.version starts with 'dev-' ? 'development version'|t('geomaps') : plugin.version }}</span>
	</footer>
</div>

{% css %}
.gm { --gm-accent: #4f46e5; --gm-accent-soft: #eef0fd; --gm-line: var(--hairline-color, rgba(51, 64, 77, 0.1)); }
.gm h2 { margin: 0 0 4px; font-size: 17px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.gm p { margin: 0; }

.gm-notice { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; margin-bottom: 20px; border-radius: 8px; background: var(--yellow-050, #fffbeb); color: var(--yellow-800, #854d0e); }
.gm-notice svg { width: 18px; height: 18px; flex: none; margin-top: 1px; }

.gm-status { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px; }
.gm-status__item { display: grid; grid-template-columns: 36px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 12px; row-gap: 3px; align-content: center; min-height: 64px; padding: 12px 14px; border: 1px solid var(--gm-line); border-radius: 10px; background: var(--gray-050, #f8fafc); }
.gm-status__icon { grid-row: 1 / span 2; align-self: center; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: #fff; color: var(--gm-accent); box-shadow: 0 0 0 1px var(--gm-line); }
.gm-status__icon svg { width: 18px; height: 18px; }
.gm-status__label { align-self: end; font-size: 11px; line-height: 1.2; color: var(--light-text-color, #64748b); text-transform: uppercase; letter-spacing: 0.05em; }
.gm-status__value { align-self: start; display: flex; align-items: center; gap: 7px; min-width: 0; font-weight: 600; font-size: 14px; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gm-status__value .status { flex: none; margin: 0; }
.gm-status__link { font-size: 12px; font-weight: 500; }
.gm-status__sub { font-weight: 500; font-size: 12px; color: var(--light-text-color, #64748b); }
.gm-status__value .gm-badge { font-size: 12px; padding: 2px 10px; }

.gm-card { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 8px 32px; padding: 24px 0; border-top: 1px solid var(--gm-line); }
.gm-card__head { display: flex; gap: 12px; align-items: flex-start; }
.gm-card__head p { color: var(--medium-text-color, #475569); font-size: 13px; line-height: 1.55; }
.gm-card__icon { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 9px; background: var(--gm-accent-soft); color: var(--gm-accent); }
.gm-card__icon svg { width: 19px; height: 19px; }
.gm-card__body > .field:first-child { margin-top: 0; }
.gm-card__body .field + .field, .gm-card__body .gm-preview + .field { margin-top: 20px; }

.gm-badge { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; background: var(--gray-100, #f1f5f9); color: var(--medium-text-color, #475569); }
.gm-badge--pro { background: var(--gm-accent); color: #fff; }
.gm-badge--on { background: #dcfce7; color: #166534; }
.gm-badge--warn { background: #fef3c7; color: #92400e; }
.gm-badge .status { margin: 0; width: 7px; height: 7px; }

.gm-help { margin-top: 18px; padding: 12px 14px; border-radius: 8px; background: var(--gray-050, #f8fafc); border: 1px solid var(--gm-line); }
.gm-help summary { cursor: pointer; font-weight: 600; color: var(--link-color, #2563eb); }
.gm-help ol { margin: 10px 0 2px 18px; padding: 0; list-style: decimal; }
.gm-help li { margin: 6px 0; line-height: 1.5; }

.gm-presets { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 6px; }
.gm-presets__label { font-size: 12px; font-weight: 600; color: var(--light-text-color, #64748b); margin-right: 4px; }
.gm-preset { padding: 4px 11px; border-radius: 999px; border: 1px solid var(--gm-line); background: #fff; font-size: 12px; font-weight: 500; cursor: pointer; color: var(--text-color, #1f2937); }
.gm-preset:hover { border-color: var(--gm-accent); color: var(--gm-accent); }
.gm-preset.is-on { background: var(--gm-accent); border-color: var(--gm-accent); color: #fff; }
.gm-presets__note { margin: 0 0 16px !important; font-size: 12px; line-height: 1.5; color: var(--light-text-color, #64748b); }
.gm-preview { margin-top: 12px; }
.gm-services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.gm-service { position: relative; display: flex; flex-direction: column; gap: 4px; padding: 14px 14px 13px; border: 1px solid var(--gm-line); border-radius: 10px; background: #fff; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
.gm-service:hover { border-color: color-mix(in srgb, var(--gm-accent) 45%, transparent); }
.gm-service.is-on { border-color: var(--gm-accent); box-shadow: 0 0 0 1px var(--gm-accent); background: var(--gm-accent-soft); }
.gm-service input { position: absolute; opacity: 0; pointer-events: none; }
.gm-service:has(input:focus-visible) { outline: 2px solid var(--gm-accent); outline-offset: 2px; }
.gm-service:has(input:disabled) { cursor: not-allowed; opacity: .75; }
.gm-service__name { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-weight: 600; font-size: 14px; color: var(--text-color, #1f2937); }
.gm-service__text { font-size: 12px; line-height: 1.45; color: var(--medium-text-color, #475569); }
.gm-service.is-on .gm-badge:not(.gm-badge--on):not(.gm-badge--warn) { background: #fff; }
.gm-service__name .gm-badge { flex: none; white-space: nowrap; }
.gm-panel { margin-top: 22px; }
.gm-panel[hidden] { display: none; }
.gm-panel > .field:first-child { margin-top: 0; }
.gm-panel .field + .field, .gm-panel .field + .gm-preview { margin-top: 20px; }
.gm-panel__intro { font-size: 13px; line-height: 1.55; color: var(--medium-text-color, #475569); }
.gm-panel__note { margin-top: 14px !important; font-size: 12px; line-height: 1.5; color: var(--light-text-color, #64748b); }
.gm-panel .gm-help { margin-top: 16px; }
.gm-panel .gm-help .field { margin-top: 14px; }
.gm-panel .gm-presets { margin: 4px 0 8px; }

.gm-preview__tiles { display: grid; grid-template-columns: repeat(4, 1fr); height: 132px; overflow: hidden; border-radius: 8px; border: 1px solid var(--gm-line); background: var(--gray-100, #f1f5f9); }
.gm-preview__tiles img { width: 100%; height: 132px; object-fit: cover; display: block; }
.gm-preview__tiles.is-empty::after { content: attr(data-message); grid-column: 1 / -1; align-self: center; text-align: center; font-size: 12px; color: var(--light-text-color, #64748b); }
.gm-preview__caption { margin-top: 6px !important; font-size: 12px; color: var(--light-text-color, #64748b); }


.gm-footer { display: flex; flex-wrap: wrap; gap: 18px; padding-top: 18px; border-top: 1px solid var(--gm-line); font-size: 13px; }
.gm-footer span { margin-left: auto; color: var(--light-text-color, #64748b); }

@media (max-width: 1100px) { .gm-status { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 1000px) { .gm-services { grid-template-columns: 1fr; } }
@media (max-width: 800px) {
	.gm-card { grid-template-columns: 1fr; }
		.gm-status { grid-template-columns: 1fr; }
}
{% endcss %}

{% js %}
(() => {
	// Show the fields for the chosen service.
	const radios = [...document.querySelectorAll('[data-gm-service]')];
	const panels = [...document.querySelectorAll('[data-gm-panel]')];
	const show = () => {
		const chosen = radios.find((r) => r.checked)?.value;
		radios.forEach((r) => r.closest('.gm-service').classList.toggle('is-on', r.checked));
		panels.forEach((p) => { p.hidden = p.dataset.gmPanel !== chosen; });
		if (chosen === 'mapbox') render();
	};
	radios.forEach((r) => r.addEventListener('change', show));

	// Mapbox style buttons and preview: four tiles across Adelaide at zoom 12.
	const style = document.getElementById('{{ 'mapboxStyle'|namespaceInputId }}');
	const token = document.getElementById('{{ 'mapboxToken'|namespaceInputId }}');
	const preview = document.querySelector('[data-gm-preview]');
	const buttons = [...document.querySelectorAll('[data-gm-style]')];
	const normalise = (value) => (value || '').trim().replace(/^mapbox:\/\/styles\//, '').replace(/^https:\/\/api\.mapbox\.com\/styles\/v1\//, '').replace(/\/$/, '');
	const markStyle = () => buttons.forEach((b) => b.classList.toggle('is-on', b.dataset.gmStyle === normalise(style?.value)));
	buttons.forEach((b) => b.addEventListener('click', () => { if (style && !style.disabled) { style.value = b.dataset.gmStyle; markStyle(); render(); } }));

	let timer;
	const render = () => {
		if (!preview || !style) return;
		const strip = preview.querySelector('.gm-preview__tiles');
		const caption = preview.querySelector('.gm-preview__caption');
		const typed = (token?.value || '').trim();
		// A token in an environment variable is only known on the server: use the saved one.
		const key = typed.startsWith('pk.') ? typed : preview.dataset.token;
		caption.textContent = typed && !typed.startsWith('pk.') && !preview.dataset.token ? caption.dataset.env : caption.dataset.default;
		strip.innerHTML = '';
		strip.classList.remove('is-empty');
		const id = normalise(style.value);
		if (!key || !/^[\w.-]+\/[\w.-]+$/.test(id)) {
			strip.classList.add('is-empty');
			strip.dataset.message = key ? {{ 'Enter a Mapbox style.'|t('geomaps')|json_encode|raw }} : {{ 'Add an access token and save to see a preview.'|t('geomaps')|json_encode|raw }};
			return;
		}
		[3623, 3624, 3625, 3626].forEach((x) => {
			const img = document.createElement('img');
			img.alt = '';
			img.src = `https://api.mapbox.com/styles/v1/${id}/tiles/256/12/${x}/2472@2x?access_token=${encodeURIComponent(key)}`;
			img.onerror = () => {
				strip.classList.add('is-empty');
				strip.dataset.message = {{ 'These tiles didn’t load. Check the token, its URL restrictions and the style.'|t('geomaps')|json_encode|raw }};
				strip.querySelectorAll('img').forEach((i) => i.remove());
			};
			strip.append(img);
		});
	};
	[style, token].forEach((el) => el?.addEventListener('input', () => { markStyle(); clearTimeout(timer); timer = setTimeout(render, 400); }));
	markStyle();
	show();
})();
{% endjs %}
