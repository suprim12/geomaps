<h2>{{ 'Import map fields'|t('geomaps') }}</h2>

{% if fields is empty %}
	<p>{{ 'No Maps (Ether) or Craft Geoman fields were found. There’s nothing to import.'|t('geomaps') }}</p>
{% else %}
	<p>{{ 'Converts fields from Maps (Ether) and Craft Geoman into Geo Maps fields in place. Handles, field layouts and saved locations are kept, so most templates keep working. Import fields one at a time, or all at once.'|t('geomaps') }}</p>

	<p class="warning has-icon">
		<span class="icon" aria-hidden="true"></span>
		<span>{{ 'Back up your database first. Importing changes field types, which updates project config — commit the change and deploy it as usual. Other environments read the old values automatically and index them in the background.'|t('geomaps') }}</span>
	</p>

	<table class="data fullwidth">
		<thead>
			<tr>
				<th>{{ 'Field'|t('app') }}</th>
				<th>{{ 'Handle'|t('app') }}</th>
				<th>{{ 'From'|t('geomaps') }}</th>
				<th>{{ 'Saved values'|t('geomaps') }}</th>
				<th class="thin"></th>
			</tr>
		</thead>
		<tbody>
			{% for item in fields %}
				<tr>
					<td>{{ item.field.name }}</td>
					<td><code>{{ item.field.handle }}</code></td>
					<td>{{ item.sourceName }}</td>
					<td>{{ item.values|number }}</td>
					<td class="thin">
						<form method="post" accept-charset="UTF-8">
							{{ actionInput('geomaps/import') }}
							{{ csrfInput() }}
							{{ redirectInput('utilities/geomaps-import') }}
							{{ hiddenInput('fieldId', item.field.id) }}
							<button type="submit" class="btn small">{{ 'Import'|t('geomaps') }}</button>
						</form>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{% if fields|length > 1 %}
		<form method="post" accept-charset="UTF-8" style="margin-top: 20px">
			{{ actionInput('geomaps/import') }}
			{{ csrfInput() }}
			{{ redirectInput('utilities/geomaps-import') }}
			<button type="submit" class="btn submit">{{ 'Import all {count} fields'|t('geomaps', { count: fields|length }) }}</button>
		</form>
	{% endif %}

	<h3 style="margin-top: 32px">{{ 'Templates'|t('geomaps') }}</h3>
	<ul class="bullets">
		<li>{{ 'Maps (Ether): `.lat`, `.lng`, `.address`, `.parts`, `.img()` and location search keep working. Replace `craft.maps` with `craft.geomaps`.'|t('geomaps')|md(inlineOnly=true) }}</li>
		<li>{{ 'Craft Geoman: `{{ entry.field }}` still outputs the GeoJSON, and entries become searchable by distance using the centre of their shapes.'|t('geomaps')|md(inlineOnly=true) }}</li>
	</ul>
{% endif %}

{% if simpleMapInstalled and fields is empty %}
	<p>{{ 'You can now uninstall the old map plugins from the <a href="{url}">Plugins</a> page.'|t('geomaps', { url: pluginsUrl })|raw }}</p>
{% endif %}
